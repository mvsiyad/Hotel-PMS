# ============================================
# Hotel PMS - Environment Configuration
# Copy to .env and fill in values
# ============================================

# Application
APP_NAME="Hotel PMS"
APP_VERSION="1.0.0"
DEBUG=true

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY="hotel-pms-super-secret-key-change-this-in-production-2024"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
INTEGRATION_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./pms.db"
# For PostgreSQL: DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/hotel_pms"

# CORS
ALLOWED_ORIGINS=["http://localhost:5174","http://localhost:3000"]

# First PMS Admin (created on first startup)
FIRST_ADMIN_EMAIL="admin@hotelpms.com"
FIRST_ADMIN_PASSWORD="Admin@123!"
FIRST_ADMIN_FIRST_NAME="PMS"
FIRST_ADMIN_LAST_NAME="Administrator"

# Default Hotel (created on first startup)
FIRST_HOTEL_NAME="Grand Azure Hotel"
FIRST_HOTEL_ADDRESS="123 Ocean Drive, Miami Beach, FL 33139"
FIRST_HOTEL_PHONE="+1-305-555-0100"
FIRST_HOTEL_EMAIL="info@grandazure.com"
FIRST_HOTEL_TIMEZONE="America/New_York"
FIRST_HOTEL_CURRENCY="USD"
